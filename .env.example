# ==========================================
# WFM Enterprise - Environment Configuration
# ==========================================

# 1. Google OAuth
# Your Google Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=86499916327-m15gl5q3b9c3mnglv1tdprnnu3bnktf3.apps.googleusercontent.com

# 2. Security (Backend JWT)
# Generate a secure random string for this (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Supabase Configuration
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
JWT_SECRET=replace_this_with_a_highly_secure_random_string

# 3. Google Sheets Integration (Service Account)
# The ID of the spreadsheet containing the "Users_Whitelist" tab
GOOGLE_SHEET_ID=your_google_sheet_id_here
# The client email from your Service Account JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# The private key from your Service Account JSON (Replace literal \n with actual newlines or ensure it parses correctly)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Note: Create a copy of this file named ".env" and fill in your actual credentials.
# DO NOT commit the real ".env" file to version control.
